# Copy to .env and fill in real values. .env is gitignored — never commit it.

DATABASE_URL="postgresql://user:password@host:port/dbname"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Mapbox Geocoding API — https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=""

# Absolute base URL of the app, used to build links in emails/SMS
# (verification links, load-alert links). No trailing slash.
APP_BASE_URL="http://localhost:3000"

# Resend — https://resend.com/api-keys
# Sandbox sender (onboarding@resend.dev) only delivers to the Resend
# account owner's own verified email. Swap in a verified domain sender
# here once DNS is sorted — no code change needed.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Twilio — Console dashboard has both Live and Test credential pairs.
# TWILIO_SMS_LIVE must be the literal string "true" to send real SMS;
# anything else (including unset) always uses the Test pair, which never
# sends a real message or costs money regardless of A2P 10DLC status.
# Leave this false until the Compliance Profile actually clears.
TWILIO_SMS_LIVE="false"
TWILIO_TEST_ACCOUNT_SID=""
TWILIO_TEST_AUTH_TOKEN=""
TWILIO_LIVE_ACCOUNT_SID=""
TWILIO_LIVE_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
