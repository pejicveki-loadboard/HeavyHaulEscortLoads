// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums -------------------------------------------------------------

enum SubscriptionStatus {
  none
  trialing
  active
  expired
}

enum LoadStatus {
  open
  covered
  expired
}

enum RateUnit {
  flat
  per_mile
}

// The 7 confirmed escort-position types to launch with (see PHASE1_PLAN.md Day 0 prep).
enum EscortPosition {
  LEAD
  CHASE
  HIGH_POLE
  STEER
  ROUTE_SURVEY
  THIRD_CAR
  FOURTH_CAR
}

enum AlertChannel {
  email
  sms
}

enum AlertSendStatus {
  sent
  failed
}

// A SearchLocation's channel preference -- distinct from AlertChannel
// (which is just email|sms, used to log/dedupe individual sends).
enum AlertChannelPreference {
  email
  sms
  both
}

// --- Models --------------------------------------------------------------

// One login per email. No general role enum here on purpose — Load Manager
// and Pilot Car capabilities are independent profile records a User may or
// may not have. See PHASE1_PLAN.md "Access control model".
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  isAdmin      Boolean  @default(false) @map("is_admin")
  createdAt    DateTime @default(now()) @map("created_at")

  // Added 2026-08-21 alongside the Resend integration for load alerts.
  // Verification is additive, not a login gate -- an unverified user can
  // still sign in and use the app; this just tracks/display status and
  // backs the /api/auth/verify-email link.
  emailVerifiedAt                 DateTime? @map("email_verified_at")
  emailVerificationToken          String?   @unique @map("email_verification_token")
  emailVerificationTokenExpiresAt DateTime? @map("email_verification_token_expires_at")

  loadManagerProfile LoadManagerProfile?
  pilotCarProfile    PilotCarProfile?

  @@map("users")
}

// Presence of this record means the user can post loads. Always free,
// no subscription check, ever.
model LoadManagerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  companyName String   @map("company_name")
  phone       String
  dotNumber   String?  @map("dot_number")
  mcNumber    String?  @map("mc_number")
  createdAt   DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  loads Load[]

  @@map("load_manager_profiles")
}

// Presence of this record means the user wants driver/load-board access,
// but every load-board-data endpoint must check subscriptionStatus
// server-side on every request (trialing-and-not-expired, or active, only).
//
// Home base / radius / escort positions used to live directly on this
// model, but a company can run multiple independent searches (e.g. one
// truck per region), so those fields moved to SearchLocation (one-to-many).
// A profile-wide alertsMuted kill switch used to live here too, but per the
// plan's per-SearchLocation correction, mute/pause is just SearchLocation's
// own `active` flag (already existed, already wired into matching) --
// removed 2026-08-23 rather than keep two flags that both meant "send no
// alerts here."
model PilotCarProfile {
  id          String @id @default(cuid())
  userId      String @unique @map("user_id")
  companyName String @map("company_name")
  phone       String

  // "signed up" for admin-visibility purposes
  createdAt DateTime @default(now()) @map("created_at")

  subscriptionStatus SubscriptionStatus @default(none) @map("subscription_status")
  // Set the moment the profile is created.
  trialStartedAt     DateTime?          @map("trial_started_at")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  // Set the moment subscriptionStatus first transitions to `active`; null until then.
  paidStartedAt      DateTime?          @map("paid_started_at")

  // Stripe columns can exist now even though Stripe wiring is Phase 2.
  stripeCustomerId     String? @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchLocations SearchLocation[]

  @@map("pilot_car_profiles")
}

// One independent saved search per Pilot Car profile -- own base
// city/state, radius, and escort-position preferences. Matching/alerts
// (Week 2) run per SearchLocation with no dedup across a profile's own
// locations, so a company running 3 active locations gets independently
// matched alerts for each.
model SearchLocation {
  id        String @id @default(cuid())
  profileId String @map("profile_id")

  // Free text, e.g. "Truck 2 -- Texas route". Not required.
  label String?

  city  String
  state String
  // Nullable until Week 2's geocoding key is wired up.
  lat   Float?
  lng   Float?

  radiusMiles     Int                    @map("radius_miles")
  escortPositions EscortPosition[]       @map("escort_positions")
  active          Boolean                @default(true)
  // Which channel(s) matching alerts fire on for this location. Added
  // 2026-08-23 (Week 2 Day 5), defaulted to `both` initially. Changed to
  // `email` 2026-08-25: Twilio's A2P 10DLC web-form consent rules require
  // the SMS opt-in to never be pre-selected, so new rows must not default
  // into SMS. The search-location form now shows an explicit, unchecked
  // SMS consent checkbox -- see search-location-form.tsx.
  alertChannel    AlertChannelPreference @default(email) @map("alert_channel")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile    PilotCarProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  loadAlerts LoadAlert[]

  @@map("search_locations")
}

model Load {
  id String @id @default(cuid())

  originCity  String @map("origin_city")
  originState String @map("origin_state")
  originLat   Float  @map("origin_lat")
  originLng   Float  @map("origin_lng")

  destinationCity  String @map("destination_city")
  destinationState String @map("destination_state")
  destinationLat   Float  @map("destination_lat")
  destinationLng   Float  @map("destination_lng")

  date DateTime

  escortPositions EscortPosition[] @map("escort_positions")

  // Dimensions and weight — captured now even though auto-flagging from
  // them is deferred past launch, so it's not a painful migration later.
  dimensionWidthFt  Float? @map("dimension_width_ft")
  dimensionHeightFt Float? @map("dimension_height_ft")
  dimensionLengthFt Float? @map("dimension_length_ft")
  weightLbs         Float? @map("weight_lbs")

  rate     Decimal?  @db.Decimal(10, 2)
  rateUnit RateUnit? @map("rate_unit")

  postedById String             @map("posted_by_id")
  postedBy   LoadManagerProfile @relation(fields: [postedById], references: [id])

  status    LoadStatus @default(open)
  createdAt DateTime   @default(now()) @map("created_at")
  // Set whenever status transitions to `covered` (cleared back to null on
  // reopen), so the Load Manager dashboard's "Covered this month" stat can
  // filter on when a load was actually marked covered, not when it was
  // posted. See PATCH /api/loads/[id].
  coveredAt DateTime? @map("covered_at")

  loadAlerts LoadAlert[]

  @@map("loads")
}

// A simple send log so a load never emails/texts the same search location
// twice on the same channel (e.g., on repost or edit), and so the Load
// Manager dashboard's "X notifications sent" stat has something to count.
// Scoped to SearchLocation, not PilotCarProfile, so a profile's own
// locations are never deduped against each other -- each is an independent
// search. channel added 2026-08-21: email and SMS are logged/deduped
// separately, since Day 4 fires both per match.
//
// status/attempts added 2026-08-22: the row is inserted (claiming the
// slot, status defaults to failed) before the send is attempted, so a
// concurrent re-trigger can never double-claim it; status flips to `sent`
// only on confirmed success. attempts is the real, queryable guard against
// retrying more than once -- see src/lib/load-matching.ts's retry pass.
// sentAt is really "claimed at", not "confirmed delivered at" -- status is
// the source of truth for delivery outcome.
model LoadAlert {
  id               String          @id @default(cuid())
  loadId           String          @map("load_id")
  searchLocationId String          @map("search_location_id")
  channel          AlertChannel
  status           AlertSendStatus @default(failed)
  attempts         Int             @default(0)
  sentAt           DateTime        @default(now()) @map("sent_at")

  load           Load           @relation(fields: [loadId], references: [id], onDelete: Cascade)
  searchLocation SearchLocation @relation(fields: [searchLocationId], references: [id], onDelete: Cascade)

  @@unique([loadId, searchLocationId, channel])
  @@map("load_alerts")
}
